# ==============================================================================
# NetMon ITOps 生产环境配置文件 (.env)
# ==============================================================================

# ── 基础运行配置 ──
NODE_ENV=production
PORT=8088
LOG_LEVEL=info
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# ── 生产环境 MySQL 业务元数据与配置库 ──
# 启用 MySQL 模式后，所有业务实体、配置、用户、设备将持久化到 MySQL
MYSQL_ENABLED=true
MYSQL_DSN=root:yourpassword@tcp(127.0.0.1:3306)/wangguan?charset=utf8mb4&parseTime=True&loc=Local

# ── 生产环境 InfluxDB 时序监控指标库 ──
# 启用后，高频 SNMP 采集数据将自动批量写入 InfluxDB 时序库
INFLUXDB_ENABLED=true
INFLUXDB_VERSION=v2
INFLUXDB_HOST=127.0.0.1
INFLUXDB_PORT=8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=itops
INFLUXDB_BUCKET=netmon_metrics
INFLUXDB_MEASUREMENT_PREFIX=snmp
INFLUXDB_WRITE_MODE=async
INFLUXDB_BATCH_SIZE=100
INFLUXDB_FLUSH_INTERVAL_MS=3000
