# ==============================================================================
# ITOps Agent Platform - 环境变量配置示例
# ==============================================================================
# 📝 说明：
#   - 复制此文件为 .env 并根据实际情况修改
#   - 所有配置项均为可选，有默认值
#   - AI 模型配置也可在登录后在网页 "设置 → AI 配置" 中设置

# ==============================================================================
# 🔧 基础配置
# ==============================================================================

# 运行环境 (development/production)
# 默认: production
NODE_ENV=development

# 后端服务端口
# 默认: 8088
PORT=8088

# SQLite 数据库文件路径（当未开启 MYSQL_ENABLED 时生效）
# 默认: ./data/app.db
DATABASE_PATH=./data/app.db

# 日志级别: debug, info, warn, error
# 默认: info
LOG_LEVEL=info

# ==============================================================================
# 🗄️ 生产环境 MySQL 配置（业务元数据与常用配置库）
# ==============================================================================
# 启用 MySQL 替代 SQLite 存储所有业务元数据（用户、设备资产、凭据、机房、告警规则、自愈工作流等）
# 是否启用 MySQL (true / false)
MYSQL_ENABLED=false
# MySQL DSN 连接字符串（支持 MySQL 5.7 / 8.0 / MariaDB）
# 格式: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DSN=root:yourpassword@tcp(127.0.0.1:3306)/itops?charset=utf8mb4&parseTime=True&loc=Local

# ==============================================================================
# 📈 生产环境 InfluxDB 时序库配置（网络设备与监控指标时序存储）
# ==============================================================================
# 启用 InfluxDB 接收网络设备 SNMP 采集流速、网口吞吐、硬件与自定义 OID 时序指标
# 是否启用 InfluxDB 时序写入 (true / false)
INFLUXDB_ENABLED=false
# InfluxDB 版本: v1 | v2 | v3
INFLUXDB_VERSION=v2
INFLUXDB_HOST=127.0.0.1
INFLUXDB_PORT=8086
# InfluxDB 2.x/3.x 配置
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=itops
INFLUXDB_BUCKET=netmon_metrics
# InfluxDB 1.x 配置（使用 v1 时生效）
INFLUXDB_USERNAME=root
INFLUXDB_PASSWORD=root
INFLUXDB_DATABASE=netmon_metrics
INFLUXDB_RETENTION_POLICY=autogen
# 写入控制
INFLUXDB_MEASUREMENT_PREFIX=snmp
INFLUXDB_WRITE_MODE=async
INFLUXDB_BATCH_SIZE=100
INFLUXDB_FLUSH_INTERVAL_MS=3000

# ==============================================================================
# 🔐 JWT 认证配置
# ==============================================================================

# JWT 签名密钥（生产环境必须修改！）
# 🚨 安全警告：生产环境必须使用强随机密钥
# 生成命令: openssl rand -hex 32
# 留空时开发环境自动生成（重启后 token 失效）；生产环境必须设置
JWT_SECRET=

# Access Token 有效期
# 格式示例: 24h, 7d, 60m
# 默认: 24h
JWT_EXPIRES_IN=24h

# ==============================================================================
# 🔐 加密与认证强化
# ==============================================================================

# 用于加密 SSH/VNC/数据库等凭据（>=32 字节）；留空则回退 JWT_SECRET（兼容存量密文）
# 生成命令: openssl rand -hex 32
ENCRYPTION_KEY=

# 仅开发环境可用：未认证请求注入管理员身份；生产环境强制忽略
AUTH_DEV_BYPASS=false

# 可信反向代理 IP/CIDR（逗号分隔）；仅当直连地址命中时才信任 X-Forwarded-For
TRUSTED_PROXIES=

# 首次部署（users 表为空）时自动生成随机 admin 口令并写入
# <DATABASE_PATH 所在目录>/initial-admin-password.txt（权限 0600），日志仅打印路径

# ==============================================================================
# 🌐 CORS 跨域配置
# ==============================================================================

# 允许的跨域来源（逗号分隔多个地址）
# 建议仅允许实际访问的域名，增强安全性
# 默认: http://localhost:3000,http://localhost:8088
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8088

# ==============================================================================
# 🤖 AI 模型配置（豆包 / 火山引擎）
# ==============================================================================
# 注意：这些配置也可以在登录后在网页 "设置 → AI 配置" 中设置

# 豆包 API 密钥
# 申请地址: https://console.volcengine.com/ark
DOUBAO_API_KEY=

# 豆包 API 地址
# 默认: https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# 豆包模型名称
# 示例: doubao-4o, doubao-pro-32k, doubao-lite-32k
# 默认: doubao-4o
DOUBAO_MODEL=doubao-4o

# ==============================================================================
# 🤖 AI 模型配置（OpenAI / 兼容 OpenAI 接口）
# ==============================================================================

# OpenAI API 密钥
OPENAI_API_KEY=

# OpenAI API 地址
# 默认: https://api.openai.com/v1
OPENAI_API_BASE=https://api.openai.com/v1

# OpenAI 模型名称
# 示例: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# 默认: gpt-4o
OPENAI_MODEL=gpt-4o

# ==============================================================================
# 🏠 本地 AI 模型配置（Ollama / LM Studio / vLLM 等）
# ==============================================================================

# 本地 AI API 密钥（可选）
LOCAL_AI_API_KEY=

# 本地 AI API 地址
# Ollama 示例: http://localhost:11434/v1
# LM Studio 示例: http://localhost:1234/v1
LOCAL_AI_API_BASE=

# 本地 AI 模型名称
# 示例: qwen2.5, llama3, deepseek-coder, yi
LOCAL_AI_MODEL=

# ==============================================================================
# 🚨 Webhook 安全配置（告警接收）
# ==============================================================================
# 📝 生产环境强烈建议配置，防止伪造告警攻击

# Webhook 签名验证模式（secure by default）
#   true  (默认): 强制校验签名，缺失或错误均拒绝（生产环境推荐）
#   warn        : 缺失签名放行但记录 WARN 审计日志，签名错误仍拒绝（向后兼容存量告警源）
#   false       : 完全关闭校验（仅用于隔离测试环境）
# 启用后，告警源必须在请求头中携带正确的 HMAC-SHA256 签名
# 签名 Header 格式: X-Webhook-Signature-{source} (如 X-Webhook-Signature-prometheus)
WEBHOOK_VERIFY_ENABLED=true

# Webhook 签名密钥
# 🚨 当 WEBHOOK_VERIFY_ENABLED=true 时必须设置为非占位值，否则启动会失败
# 本地开发若无签名告警源，可设置 WEBHOOK_VERIFY_ENABLED=warn 跳过强制校验
# 生成命令: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret-key-change-me

# Webhook IP 白名单（逗号分隔多个 IP）
# 只允许白名单中的 IP 发送告警请求
# 空值表示允许所有 IP（不推荐用于生产）
# 示例: WEBHOOK_IP_WHITELIST=192.168.1.100,10.0.0.50
WEBHOOK_IP_WHITELIST=

# ==============================================================================
# 📧 告警通知配置（邮件）
# ==============================================================================

# 告警邮件 SMTP 服务器地址
ALERT_EMAIL_HOST=smtp.example.com

# 告警邮件 SMTP 端口
# 默认: 587
ALERT_EMAIL_PORT=587

# 告警邮件用户名
ALERT_EMAIL_USER=itops@example.com

# 告警邮件密码/授权码
ALERT_EMAIL_PASS=your-email-password

# 告警邮件接收地址（逗号分隔多个）
ALERT_EMAIL_TO=admin@example.com

# 告警 Webhook 通知地址（企业微信/钉钉/Slack 等）
ALERT_WEBHOOK_URL=

# ==============================================================================
# 📚 配置优先级说明
# ==============================================================================
#
# 1. 环境变量（.env 文件）优先级最高
# 2. 网页配置（存储在数据库中）在环境变量未设置时生效
# 3. 均未配置时使用代码内的默认值
#
# 🔐 安全最佳实践：
#   - 生产环境必须设置 JWT_SECRET
#   - 生产环境保持 WEBHOOK_VERIFY_ENABLED=true 并设置强随机 WEBHOOK_SECRET
#   - 不要将包含真实密钥的 .env 文件提交到代码仓库
#   - 定期轮换所有密钥
#
# 🚀 部署后访问：
#   - 前端开发: http://localhost:3000
#   - 后端/生产: http://localhost:8088
#   - 健康检查: http://localhost:8088/api/health
#
# ==============================================================================

# ==============================================================================
# 🏗️ IDC 上架规划与布线引擎（原 IDCBoxLine）
# ==============================================================================
# 是否启用规划模块；关闭后 /api/v1/planning 返回 503，主平台其余功能不受影响
PLANNING_ENABLED=true
# 引擎根目录（含 backend/ data/ projects/ rules/ shared/）
# 留空自动查找 ./planning 或二进制同级的 planning/
PLANNING_ROOT=
# Python 解释器；留空自动使用 backend/.venv、绿色包 runtime/ 或系统 python3
PLANNING_PYTHON=
# 引擎监听端口（仅绑定 127.0.0.1，由 Go 反向代理）
PLANNING_PORT=18001
# 留空使用 <PLANNING_ROOT>/data/idcbox.db；独立数据目录可设为 <data>/planning.db
PLANNING_DB=
# 规划前端外部静态目录（开发时可指向 planning/web/dist；留空使用嵌入产物）
PLANNING_STATIC_DIR=

# ==============================================================================
# 🐳 容器管理（Docker socket）
# ==============================================================================
# docker-compose 会把 /var/run/docker.sock 挂进容器；Linux 宿主机需填 socket 属组：
#   DOCKER_GID=$(stat -c %g /var/run/docker.sock)
# Docker Desktop / OrbStack 默认 0。
DOCKER_GID=0
